DATABASE_URL="file:./dev.db"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# Generate a real secret for any non-local environment, e.g. `openssl rand -hex 32`.
JWT_SECRET="dev-only-insecure-secret-change-me"

# Scryfall card data. No API key exists — their API is free and unauthenticated.
# How often to check for a newer bulk file (0 disables the scheduler).
CARD_SYNC_INTERVAL_HOURS=24
# Goes in the User-Agent Scryfall requires, so they can reach you if needed.
SCRYFALL_CONTACT_URL="https://github.com/cw769844-max/MTG-Commander"
