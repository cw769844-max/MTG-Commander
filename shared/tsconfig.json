{
  "compilerOptions": {
    "target": "ES2022",
    // CommonJS so plain `node dist/index.js` can load this package. Emitting
    // ESNext produced extensionless imports that only a bundler could resolve,
    // which worked under Vite and tsx but broke the built server at startup.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
